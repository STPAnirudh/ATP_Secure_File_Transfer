<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/atp_obsidian">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/atp_card">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_atp_shield"
            android:contentDescription="ATP Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATP SECURE"
                android:textColor="@color/atp_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/txt_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AES-256-GCM • X25519"
                android:textColor="@color/atp_text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Status Pill with IP and Indicator -->
        <LinearLayout
            android:id="@+id/layout_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/status_indicator_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/atp_emerald"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txt_top_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="127.0.0.1"
                android:textColor="@color/atp_text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content Area Container -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== TAB 1: OVERVIEW ==================== -->
        <ScrollView
            android:id="@+id/layout_overview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Welcome Hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agnos Transfer Protocol"
                        android:textColor="@color/atp_vermilion"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Zero-Trust Local File Transfers"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="High-throughput, end-to-end encrypted wire streaming directly between devices without cloud reliance."
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Mode A Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nav_connect"
                            android:contentDescription="Mode A Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Mode A — Connect to Desktop"
                            android:textColor="@color/atp_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Scan your desktop's QR code or enter its Wi-Fi address to open the ATP dashboard and transfer files in-app."
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/btn_overview_scan"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_button_primary"
                            android:text="Scan QR"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_overview_connect_tab"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="Enter IP"
                            android:textColor="@color/atp_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mode B Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nav_host"
                            android:contentDescription="Mode B Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Mode B — Host on Phone"
                            android:textColor="@color/atp_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_overview_host"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_overview_host_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Run an ATP server node directly on your phone with background service and live QR code sharing."
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_overview_host_manage"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Open Hosting Console &amp; QR"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Cryptographic Specifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRYPTOGRAPHIC SPECIFICATIONS"
                        android:textColor="@color/atp_emerald"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• X25519 Elliptic-Curve Diffie-Hellman Key Exchange\n• HKDF-SHA256 Session Key Derivation with Salt\n• AES-256-GCM 128-bit Tag Authenticated Encryption\n• SHA-256 Digest Verification on File Completion\n• 64KB Sliding Stream Chunks with Atomic SQLite Checkpoints"
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 2: CONNECT (MODE A) ==================== -->
        <ScrollView
            android:id="@+id/layout_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Scan QR Header Button -->
                <Button
                    android:id="@+id/btn_scan_qr"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Scan Desktop QR Code"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_qr_scan"
                    android:paddingHorizontal="20dp"
                    android:drawablePadding="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Manual Connection Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual Server Address"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enter the IP address of the ATP desktop server on your Wi-Fi network."
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/input_server_url"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="14dp"
                        android:hint="http://192.168.1.5:8000"
                        android:textColorHint="@color/atp_text_muted"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:inputType="textUri"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btn_connect_manual"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Connect to Desktop"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Wi-Fi Subnet Auto-Discovery Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subnet Auto-Discovery"
                                android:textColor="@color/atp_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Search Wi-Fi subnet for ATP nodes"
                                android:textColor="@color/atp_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_discover_devices"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="Scan Subnet"
                            android:textColor="@color/atp_text_primary"
                            android:textSize="12sp"
                            android:paddingHorizontal="14dp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_discovery"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        style="?android:attr/progressBarStyleHorizontal" />

                    <TextView
                        android:id="@+id/txt_discovery_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tap 'Scan Subnet' to discover active ATP desktop servers automatically."
                        android:textColor="@color/atp_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/container_discovered_nodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 3: HOST (MODE B) ==================== -->
        <ScrollView
            android:id="@+id/layout_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hosting Master Toggle Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Android Hosting Node"
                                android:textColor="@color/atp_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_host_status_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="SERVER OFFLINE"
                                android:textColor="@color/atp_rose"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_service_hosting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/atp_border"
                        android:layout_marginVertical="14dp" />

                    <!-- Server Ports and IP Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Local IP"
                                android:textColor="@color/atp_text_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txt_host_ip_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="127.0.0.1"
                                android:textColor="@color/atp_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Web / Wire"
                                android:textColor="@color/atp_text_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=":8000 / :9000"
                                android:textColor="@color/atp_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clients"
                                android:textColor="@color/atp_text_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txt_host_client_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 Active"
                                android:textColor="@color/atp_emerald"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Dynamic QR Code Card (Visible when hosting is on) -->
                <LinearLayout
                    android:id="@+id/card_qr_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan with Any Device to Connect"
                        android:textColor="@color/atp_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Open on Chrome, Safari, or ATP app on Wi-Fi"
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="12sp" />

                    <!-- QR Frame (High Contrast White) -->
                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_qr_frame">

                        <ImageView
                            android:id="@+id/img_host_qr"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Hosting QR Code" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txt_host_full_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="http://192.168.1.100:8000"
                        android:textColor="@color/atp_vermilion"
                        android:textSize="15sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/btn_copy_host_url"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="Copy URL"
                            android:textColor="@color/atp_text_primary"
                            android:textSize="13sp"
                            android:drawableStart="@drawable/ic_copy"
                            android:paddingHorizontal="16dp"
                            android:drawablePadding="8dp" />

                        <Button
                            android:id="@+id/btn_open_local_console"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_button_primary"
                            android:text="Open In App"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Background Service Notice Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSISTENT FOREGROUND SERVICE"
                        android:textColor="@color/atp_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hosting runs as an Android Foreground Service with continuous WakeLock and High-Performance WifiLock. File transfers will not stall when your screen turns off or when multitasking."
                        android:textColor="@color/atp_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 4: CONSOLE (WEBVIEW) ==================== -->
        <LinearLayout
            android:id="@+id/layout_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- WebView Navigation Sub-Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@color/atp_card_elevated">

                <ImageButton
                    android:id="@+id/btn_web_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back" />

                <ImageButton
                    android:id="@+id/btn_web_refresh"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Refresh" />

                <TextView
                    android:id="@+id/txt_web_current_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="http://127.0.0.1:8000"
                    android:textColor="@color/atp_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:ellipsize="middle"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btn_web_external"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_open_in_browser"
                    android:contentDescription="Open in Browser" />
            </LinearLayout>

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/web_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleHorizontal" />

            <!-- Seamless In-App WebView -->
            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- ==================== TAB 5: VAULT (RECEIVED FILES) ==================== -->
        <LinearLayout
            android:id="@+id/layout_vault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Received Files Vault"
                    android:textColor="@color/atp_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_vault_refresh"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Refresh Vault" />
            </LinearLayout>

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/vault_empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="32dp"
                android:layout_marginTop="20dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_nav_vault"
                    android:contentDescription="Empty Vault" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No Received Files Yet"
                    android:textColor="@color/atp_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Files transferred over ATP will be decrypted, verified by SHA-256, and stored securely here."
                    android:textColor="@color/atp_text_secondary"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Vault Files List -->
            <ScrollView
                android:id="@+id/vault_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/container_vault_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="@color/atp_card"
        android:paddingVertical="4dp">

        <!-- Tab: Overview -->
        <LinearLayout
            android:id="@+id/tab_overview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_nav_overview"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_overview"
                android:contentDescription="Overview" />

            <TextView
                android:id="@+id/label_nav_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Overview"
                android:textColor="@color/atp_vermilion"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab: Connect (Mode A) -->
        <LinearLayout
            android:id="@+id/tab_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_nav_connect"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_connect"
                android:contentDescription="Connect" />

            <TextView
                android:id="@+id/label_nav_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Connect"
                android:textColor="@color/atp_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab: Host (Mode B) -->
        <LinearLayout
            android:id="@+id/tab_host"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_nav_host"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_host"
                android:contentDescription="Host" />

            <TextView
                android:id="@+id/label_nav_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Host"
                android:textColor="@color/atp_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab: Console / WebView -->
        <LinearLayout
            android:id="@+id/tab_console"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_nav_console"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_console"
                android:contentDescription="Console" />

            <TextView
                android:id="@+id/label_nav_console"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Console"
                android:textColor="@color/atp_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab: Vault -->
        <LinearLayout
            android:id="@+id/tab_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_nav_vault"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_vault"
                android:contentDescription="Vault" />

            <TextView
                android:id="@+id/label_nav_vault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vault"
                android:textColor="@color/atp_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
