<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_elevated"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_nav_host"
        android:contentDescription="Device Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATP Desktop Server"
            android:textColor="@color/atp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_device_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="http://192.168.1.5:8000"
            android:textColor="@color/atp_text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_connect_discovered"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_primary"
        android:text="Connect"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingHorizontal="14dp" />

</LinearLayout>
