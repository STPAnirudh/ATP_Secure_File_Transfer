<resources>
    <!-- Base application theme -->
    <style name="Theme.ATPAndroid" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/atp_obsidian</item>
        <item name="android:navigationBarColor">@color/atp_obsidian</item>
        <item name="android:windowBackground">@color/atp_obsidian</item>
        <item name="colorPrimary">@color/atp_vermilion</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/atp_emerald</item>
        <item name="colorSurface">@color/atp_card</item>
        <item name="colorOnSurface">@color/atp_text_primary</item>
    </style>

    <style name="Theme.ATPAndroid.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
