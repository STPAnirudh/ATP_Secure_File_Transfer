# ATP (Agnos Transfer Protocol) Environment Configuration

# HTTP Control API
ATP_HTTP_HOST=127.0.0.1
ATP_HTTP_PORT=8000

# TCP Socket Transfer Engine
ATP_TCP_HOST=127.0.0.1
ATP_TCP_PORT=9000

# Security & Credentials
ATP_JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string-in-production
ATP_ADMIN_USER=admin
ATP_ADMIN_PASS=admin123

# Protocol Defaults
ATP_CHUNK_SIZE=65536
ATP_MAX_CONCURRENT_CLIENTS=16
ATP_SOCKET_TIMEOUT=30
